{
  "name": "dovi-remuxer",
  "version": "1.0.0",
  "type": "module",
  "description": "Standalone cross-platform app to remux 4K Dolby Vision MKV videos to TV-compatible MP4 format using FFmpeg and mp4muxer",
  "main": "dist-electron/main.js",
  "author": "Sarath Nair (@sarathcodes)",
  "license": "MIT",
  "funding": "https://www.buymeacoffee.com/sarathcodes",
  "repository": {
    "type": "git",
    "url": "https://github.com/sarathcodes/dovi-remuxer.git"
  },
  "bugs": {
    "url": "https://github.com/sarathcodes/dovi-remuxer/issues"
  },
  "homepage": "https://github.com/sarathcodes/dovi-remuxer#readme",
  "keywords": [
    "dolby-vision",
    "dovi",
    "mkv-to-mp4",
    "mp4muxer",
    "ffmpeg",
    "lg-tv",
    "remux",
    "electron",
    "react",
    "hdr10",
    "eac3"
  ],
  "scripts": {
    "start": "node server.mjs",
    "dev": "vite",
    "build": "vite build && esbuild electron/preload.ts --bundle --platform=node --format=cjs --outfile=dist-electron/preload.cjs --external:electron && esbuild electron/engine/index.ts --bundle --platform=node --format=esm --outfile=engine.mjs",
    "build:electron": "vite build && esbuild electron/preload.ts --bundle --platform=node --format=cjs --outfile=dist-electron/preload.cjs --external:electron",
    "preview": "vite preview",
    "test": "node tests/test-pipeline.mjs",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^31.1.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "com.dovi.remuxer",
    "productName": "DoVi Remuxer",
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video",
      "identity": null,
      "gatekeeperAssess": false,
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Video"
    }
  }
}
